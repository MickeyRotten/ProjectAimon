{
  "name": "aimon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Aimon — a solo-play browser text adventure with an LLM narrator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "vitest run tests/base-campaign.test.ts",
    "sample": "cd campaigns/base && node ../../tools/sample-generate.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "dexie": "^4.4.5"
  }
}
